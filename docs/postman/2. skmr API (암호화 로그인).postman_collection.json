            "type": "text/javascript",
            "exec": [
              "// 1. CryptoJS 모듈 임포트 (Tests 탭에서도 암호화 검증이 필요할 경우 사용)\nconst CryptoJS = require('crypto-js');\n\n// 2. 상태 코드 검증\npm.test('로그인 200', () => {\n    pm.response.to.have.status(200);\n});\n\n// 3. 응답 데이터 본인 계정 검증\npm.test('본인 계정 확인', () => {\n    const responseData = pm.response.json();\n    pm.expect(responseData.username).to.eql(pm.variables.get('username'));\n});"
            ]
          }
